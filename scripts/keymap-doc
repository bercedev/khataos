#!/bin/sh
# Regenerates the key reference in docs/guide/keyboard.md from
# crates/khata-keymap/src/tally.rs. Run it after changing the key map; the
# khata-keymap test `guide_key_reference_is_up_to_date` fails until you do.
set -eu
cd "$(dirname "$0")/.."
exec cargo run --quiet -p khata-keymap --example keymap-doc -- --write
