<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written sample in the shape of a TallyPrime "Day Book > XML (Data Interchange)" export with item invoices.
     Fictional data. Tally signs amounts negative = debit. -->
<ENVELOPE>
 <HEADER>
  <TALLYREQUEST>Import Data</TALLYREQUEST>
 </HEADER>
