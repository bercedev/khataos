       <ISADVANCE>No</ISADVANCE>
       <OPENINGBALANCE>-50000.00</OPENINGBALANCE>
      </BILLALLOCATIONS.LIST>
     </LEDGER>
    </TALLYMESSAGE>

    <!-- A debtor in the newer layout: GST registration and mailing details as dated lists. -->
