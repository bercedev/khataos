      <PARTYGSTIN>27AAKFK1234M1Z5</PARTYGSTIN>
      <LEDSTATENAME>Maharashtra</LEDSTATENAME>
      <PINCODE>421302</PINCODE>
      <INCOMETAXNUMBER>AAKFK1234M</INCOMETAXNUMBER>
      <BILLCREDITPERIOD JD="45383" P="30 Days">30 Days</BILLCREDITPERIOD>
      <ISBILLWISEON>Yes</ISBILLWISEON>
      <OPENINGBALANCE>-1,50,000.00</OPENINGBALANCE>
      <BILLALLOCATIONS.LIST>
       <BILLDATE>20240210</BILLDATE>
       <NAME>OB/101</NAME>
       <BILLCREDITPERIOD JD="45362" P="30 Days">30 Days</BILLCREDITPERIOD>
       <ISADVANCE>No</ISADVANCE>
