<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written sample in the shape of a TallyPrime "Export > Masters > All Masters > XML (Data Interchange)" file.
     Every company, party, GSTIN and PAN here is invented. The GSTINs have valid check characters except Ojas Retail's.
     Older and newer TallyPrime ledger layouts are both used: direct PARTYGSTIN / LEDSTATENAME tags, and the dated
     LEDGSTREGDETAILS.LIST / LEDMAILINGDETAILS.LIST lists. -->
<ENVELOPE>
 <HEADER>
  <TALLYREQUEST>Import Data</TALLYREQUEST>
 </HEADER>
 <BODY>
  <IMPORTDATA>
   <REQUESTDESC>
    <REPORTNAME>All Masters</REPORTNAME>
    <STATICVARIABLES>
     <SVCURRENTCOMPANY>Saffron Lane Traders</SVCURRENTCOMPANY>
    </STATICVARIABLES>
   </REQUESTDESC>
   <REQUESTDATA>
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <VOUCHERTYPE NAME="Sales GST" RESERVEDNAME="">
      <PARENT>Sales</PARENT>
      <NUMBERINGMETHOD>Automatic</NUMBERINGMETHOD>
     </VOUCHERTYPE>
    </TALLYMESSAGE>
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <VOUCHERTYPE NAME="Sales Export" RESERVEDNAME="">
      <PARENT>Sales</PARENT>
     </VOUCHERTYPE>
    </TALLYMESSAGE>
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <VOUCHERTYPE NAME="Cash Sales" RESERVEDNAME="">
      <PARENT>Sales</PARENT>
     </VOUCHERTYPE>
    </TALLYMESSAGE>
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <VOUCHERTYPE NAME="Bank Payment" RESERVEDNAME="">
      <PARENT>Payment</PARENT>
     </VOUCHERTYPE>
    </TALLYMESSAGE>

    <!-- Cash and banks: a current account, a cash credit (OCC) limit and an overdraft. -->
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <LEDGER NAME="Cash" RESERVEDNAME="">
      <PARENT>Cash-in-Hand</PARENT>
      <OPENINGBALANCE>-25000.00</OPENINGBALANCE>
     </LEDGER>
    </TALLYMESSAGE>
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <LEDGER NAME="SBI Current" RESERVEDNAME="">
      <PARENT>Bank Accounts</PARENT>
      <OPENINGBALANCE>-2,00,000.00</OPENINGBALANCE>
     </LEDGER>
    </TALLYMESSAGE>
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <LEDGER NAME="SBI Cash Credit" RESERVEDNAME="">
      <PARENT>Bank OCC A/c</PARENT>
      <OPENINGBALANCE>3,00,000.00</OPENINGBALANCE>
     </LEDGER>
    </TALLYMESSAGE>
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <LEDGER NAME="HDFC Overdraft" RESERVEDNAME="">
      <PARENT>Bank OD A/c</PARENT>
      <OPENINGBALANCE>50000.00</OPENINGBALANCE>
     </LEDGER>
    </TALLYMESSAGE>
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <LEDGER NAME="Furniture" RESERVEDNAME="">
      <PARENT>Fixed Assets</PARENT>
      <OPENINGBALANCE>-1,00,000.00</OPENINGBALANCE>
     </LEDGER>
    </TALLYMESSAGE>

