<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written sample in the shape of a TallyPrime "Export > Transactions > Day Book > XML (Data Interchange)" file,
     with bill-wise details (New Ref, Agst Ref, Advance, On Account), bank allocations and a cost centre split.
     Import together with gst_masters.xml. All names are invented. -->
<ENVELOPE>
 <HEADER>
  <TALLYREQUEST>Import Data</TALLYREQUEST>
 </HEADER>
 <BODY>
  <IMPORTDATA>
   <REQUESTDESC>
    <REPORTNAME>Vouchers</REPORTNAME>
    <STATICVARIABLES>
     <SVCURRENTCOMPANY>Saffron Lane Traders</SVCURRENTCOMPANY>
    </STATICVARIABLES>
   </REQUESTDESC>
   <REQUESTDATA>
    <!-- A sale raising a new bill due in 30 days. -->
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <VOUCHER REMOTEID="bw-1" VCHTYPE="Sales GST" ACTION="Create" OBJVIEW="Accounting Voucher View">
      <DATE>20240405</DATE>
      <VOUCHERTYPENAME>Sales GST</VOUCHERTYPENAME>
      <VOUCHERNUMBER>1</VOUCHERNUMBER>
      <PARTYLEDGERNAME>Kavya Fabrics</PARTYLEDGERNAME>
      <ISCANCELLED>No</ISCANCELLED>
      <ISOPTIONAL>No</ISOPTIONAL>
      <ISPOSTDATED>No</ISPOSTDATED>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>Kavya Fabrics</LEDGERNAME>
       <ISDEEMEDPOSITIVE>Yes</ISDEEMEDPOSITIVE>
       <ISPARTYLEDGER>Yes</ISPARTYLEDGER>
       <AMOUNT>-11200.00</AMOUNT>
       <BILLALLOCATIONS.LIST>
        <NAME>SG/1</NAME>
        <BILLTYPE>New Ref</BILLTYPE>
        <BILLCREDITPERIOD JD="45417" P="30 Days">30 Days</BILLCREDITPERIOD>
        <AMOUNT>-11200.00</AMOUNT>
       </BILLALLOCATIONS.LIST>
      </ALLLEDGERENTRIES.LIST>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>Sales Local</LEDGERNAME>
       <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
       <AMOUNT>10000.00</AMOUNT>
      </ALLLEDGERENTRIES.LIST>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>CGST</LEDGERNAME>
       <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
       <AMOUNT>600.00</AMOUNT>
      </ALLLEDGERENTRIES.LIST>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>Output SGST</LEDGERNAME>
       <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
       <AMOUNT>600.00</AMOUNT>
      </ALLLEDGERENTRIES.LIST>
     </VOUCHER>
    </TALLYMESSAGE>

    <!-- A purchase whose credit period is a due date. -->
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <VOUCHER REMOTEID="bw-2" VCHTYPE="Purchase" ACTION="Create">
      <DATE>20240410</DATE>
      <VOUCHERTYPENAME>Purchase</VOUCHERTYPENAME>
      <VOUCHERNUMBER>1</VOUCHERNUMBER>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>Sahyadri Supplies</LEDGERNAME>
       <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
       <AMOUNT>22400.00</AMOUNT>
       <BILLALLOCATIONS.LIST>
        <NAME>SS/778</NAME>
        <BILLTYPE>New Ref</BILLTYPE>
        <BILLCREDITPERIOD JD="45427" P="15-May-2024">15-May-2024</BILLCREDITPERIOD>
        <AMOUNT>22400.00</AMOUNT>
       </BILLALLOCATIONS.LIST>
      </ALLLEDGERENTRIES.LIST>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>Purchases</LEDGERNAME>
       <ISDEEMEDPOSITIVE>Yes</ISDEEMEDPOSITIVE>
       <AMOUNT>-20000.00</AMOUNT>
      </ALLLEDGERENTRIES.LIST>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>CGST</LEDGERNAME>
       <ISDEEMEDPOSITIVE>Yes</ISDEEMEDPOSITIVE>
       <AMOUNT>-1200.00</AMOUNT>
      </ALLLEDGERENTRIES.LIST>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>Input SGST</LEDGERNAME>
       <ISDEEMEDPOSITIVE>Yes</ISDEEMEDPOSITIVE>
       <AMOUNT>-1200.00</AMOUNT>
      </ALLLEDGERENTRIES.LIST>
     </VOUCHER>
    </TALLYMESSAGE>

    <!-- A receipt settling an opening bill and part of a new one, cleared by the bank two days later. -->
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <VOUCHER REMOTEID="bw-3" VCHTYPE="Receipt" ACTION="Create">
      <DATE>20240420</DATE>
      <VOUCHERTYPENAME>Receipt</VOUCHERTYPENAME>
      <VOUCHERNUMBER>1</VOUCHERNUMBER>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>Kavya Fabrics</LEDGERNAME>
       <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
       <AMOUNT>105000.00</AMOUNT>
       <BILLALLOCATIONS.LIST>
        <NAME>OB/101</NAME>
        <BILLTYPE>Agst Ref</BILLTYPE>
        <AMOUNT>100000.00</AMOUNT>
       </BILLALLOCATIONS.LIST>
       <BILLALLOCATIONS.LIST>
        <NAME>SG/1</NAME>
        <BILLTYPE>Agst Ref</BILLTYPE>
        <AMOUNT>5000.00</AMOUNT>
       </BILLALLOCATIONS.LIST>
      </ALLLEDGERENTRIES.LIST>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>SBI Current</LEDGERNAME>
       <ISDEEMEDPOSITIVE>Yes</ISDEEMEDPOSITIVE>
       <AMOUNT>-105000.00</AMOUNT>
       <BANKALLOCATIONS.LIST>
        <DATE>20240420</DATE>
        <INSTRUMENTDATE>20240420</INSTRUMENTDATE>
        <BANKERSDATE>20240422</BANKERSDATE>
        <TRANSACTIONTYPE>Cheque</TRANSACTIONTYPE>
        <INSTRUMENTNUMBER>004512</INSTRUMENTNUMBER>
        <AMOUNT>-105000.00</AMOUNT>
       </BANKALLOCATIONS.LIST>
      </ALLLEDGERENTRIES.LIST>
     </VOUCHER>
    </TALLYMESSAGE>

    <!-- An advance before any bill. -->
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <VOUCHER REMOTEID="bw-4" VCHTYPE="Receipt" ACTION="Create">
      <DATE>20240425</DATE>
      <VOUCHERTYPENAME>Receipt</VOUCHERTYPENAME>
      <VOUCHERNUMBER>2</VOUCHERNUMBER>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>Nilgiri Exports</LEDGERNAME>
       <AMOUNT>8000.00</AMOUNT>
       <BILLALLOCATIONS.LIST>
        <NAME>ADV/N1</NAME>
        <BILLTYPE>Advance</BILLTYPE>
        <AMOUNT>8000.00</AMOUNT>
       </BILLALLOCATIONS.LIST>
      </ALLLEDGERENTRIES.LIST>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>Cash</LEDGERNAME>
       <AMOUNT>-8000.00</AMOUNT>
      </ALLLEDGERENTRIES.LIST>
     </VOUCHER>
    </TALLYMESSAGE>

    <!-- Money on account. -->
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <VOUCHER REMOTEID="bw-5" VCHTYPE="Receipt" ACTION="Create">
      <DATE>20240428</DATE>
      <VOUCHERTYPENAME>Receipt</VOUCHERTYPENAME>
      <VOUCHERNUMBER>3</VOUCHERNUMBER>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>Kavya Fabrics</LEDGERNAME>
       <AMOUNT>2000.00</AMOUNT>
       <BILLALLOCATIONS.LIST>
        <BILLTYPE>On Account</BILLTYPE>
        <AMOUNT>2000.00</AMOUNT>
       </BILLALLOCATIONS.LIST>
      </ALLLEDGERENTRIES.LIST>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>Cash</LEDGERNAME>
       <AMOUNT>-2000.00</AMOUNT>
      </ALLLEDGERENTRIES.LIST>
     </VOUCHER>
    </TALLYMESSAGE>

    <!-- A custom payment type settling an opening bill from the cash credit account. -->
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <VOUCHER REMOTEID="bw-6" VCHTYPE="Bank Payment" ACTION="Create">
      <DATE>20240430</DATE>
      <VOUCHERTYPENAME>Bank Payment</VOUCHERTYPENAME>
      <VOUCHERNUMBER>1</VOUCHERNUMBER>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>Sahyadri Supplies</LEDGERNAME>
       <AMOUNT>-40000.00</AMOUNT>
       <BILLALLOCATIONS.LIST>
        <NAME>PB-9</NAME>
        <BILLTYPE>Agst Ref</BILLTYPE>
        <AMOUNT>-40000.00</AMOUNT>
       </BILLALLOCATIONS.LIST>
      </ALLLEDGERENTRIES.LIST>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>SBI Cash Credit</LEDGERNAME>
       <AMOUNT>40000.00</AMOUNT>
       <BANKALLOCATIONS.LIST>
        <BANKERSDATE>20240502</BANKERSDATE>
        <AMOUNT>40000.00</AMOUNT>
       </BANKALLOCATIONS.LIST>
      </ALLLEDGERENTRIES.LIST>
     </VOUCHER>
    </TALLYMESSAGE>

    <!-- Bills that mix a debit and a credit on one line: KhataOS can't keep them, so the voucher posts without them. -->
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <VOUCHER REMOTEID="bw-7" VCHTYPE="Journal" ACTION="Create">
      <DATE>20240502</DATE>
      <VOUCHERTYPENAME>Journal</VOUCHERTYPENAME>
      <VOUCHERNUMBER>1</VOUCHERNUMBER>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>Kavya Fabrics</LEDGERNAME>
       <AMOUNT>-1000.00</AMOUNT>
       <BILLALLOCATIONS.LIST>
        <NAME>DN/1</NAME>
        <BILLTYPE>New Ref</BILLTYPE>
        <AMOUNT>-1500.00</AMOUNT>
       </BILLALLOCATIONS.LIST>
       <BILLALLOCATIONS.LIST>
        <NAME>SG/1</NAME>
        <BILLTYPE>Agst Ref</BILLTYPE>
        <AMOUNT>500.00</AMOUNT>
       </BILLALLOCATIONS.LIST>
      </ALLLEDGERENTRIES.LIST>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>Rate Difference</LEDGERNAME>
       <AMOUNT>1000.00</AMOUNT>
      </ALLLEDGERENTRIES.LIST>
     </VOUCHER>
    </TALLYMESSAGE>

    <!-- An export invoice that also adjusts the advance, with a cost centre split on the sales line. -->
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <VOUCHER REMOTEID="bw-8" VCHTYPE="Sales Export" ACTION="Create">
      <DATE>20240510</DATE>
      <VOUCHERTYPENAME>Sales Export</VOUCHERTYPENAME>
      <VOUCHERNUMBER>1</VOUCHERNUMBER>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>Nilgiri Exports</LEDGERNAME>
       <AMOUNT>-11800.00</AMOUNT>
       <BILLALLOCATIONS.LIST>
        <NAME>SE/1</NAME>
        <BILLTYPE>New Ref</BILLTYPE>
        <BILLCREDITPERIOD JD="45467" P="45 Days">45 Days</BILLCREDITPERIOD>
        <AMOUNT>-3800.00</AMOUNT>
       </BILLALLOCATIONS.LIST>
       <BILLALLOCATIONS.LIST>
        <NAME>ADV/N1</NAME>
        <BILLTYPE>Agst Ref</BILLTYPE>
        <AMOUNT>-8000.00</AMOUNT>
       </BILLALLOCATIONS.LIST>
      </ALLLEDGERENTRIES.LIST>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>Sales Local</LEDGERNAME>
       <AMOUNT>10000.00</AMOUNT>
       <CATEGORYALLOCATIONS.LIST>
        <CATEGORY>Primary Cost Category</CATEGORY>
        <COSTCENTREALLOCATIONS.LIST>
         <NAME>Export Desk</NAME>
         <AMOUNT>10000.00</AMOUNT>
        </COSTCENTREALLOCATIONS.LIST>
       </CATEGORYALLOCATIONS.LIST>
      </ALLLEDGERENTRIES.LIST>
      <ALLLEDGERENTRIES.LIST>
       <LEDGERNAME>IGST</LEDGERNAME>
       <AMOUNT>1800.00</AMOUNT>
      </ALLLEDGERENTRIES.LIST>
     </VOUCHER>
    </TALLYMESSAGE>
   </REQUESTDATA>
  </IMPORTDATA>
 </BODY>
</ENVELOPE>
