     </LEDGER>
    </TALLYMESSAGE>

    <!-- GST duty ledgers. CGST serves both sales and purchases; the SGST pair says its side in the name;
         IGST is used on sales only; the cess ledger is not under Duties & Taxes. -->
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <LEDGER NAME="CGST" RESERVEDNAME="">
      <PARENT>Duties &amp; Taxes</PARENT>
      <TAXTYPE>GST</TAXTYPE>
      <GSTDUTYHEAD>Central Tax</GSTDUTYHEAD>
     </LEDGER>
    </TALLYMESSAGE>
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <LEDGER NAME="Output SGST" RESERVEDNAME="">
      <PARENT>Duties &amp; Taxes</PARENT>
      <TAXTYPE>GST</TAXTYPE>
      <GSTDUTYHEAD>State Tax</GSTDUTYHEAD>
     </LEDGER>
    </TALLYMESSAGE>
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <LEDGER NAME="Input SGST" RESERVEDNAME="">
      <PARENT>Duties &amp; Taxes</PARENT>
      <TAXTYPE>GST</TAXTYPE>
      <GSTDUTYHEAD>State Tax</GSTDUTYHEAD>
     </LEDGER>
    </TALLYMESSAGE>
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <LEDGER NAME="IGST" RESERVEDNAME="">
      <PARENT>Duties &amp; Taxes</PARENT>
      <TAXTYPE>GST</TAXTYPE>
      <GSTDUTYHEAD>Integrated Tax</GSTDUTYHEAD>
     </LEDGER>
    </TALLYMESSAGE>
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <LEDGER NAME="GST Cess" RESERVEDNAME="">
      <PARENT>Current Liabilities</PARENT>
      <TAXTYPE>GST</TAXTYPE>
      <GSTDUTYHEAD>Cess</GSTDUTYHEAD>
     </LEDGER>
    </TALLYMESSAGE>

